     normalize_user = json_extract_scalar(normalize_user, "$.string"),
     auth_policy = json_extract_scalar(auth_policy, "$.string"),
     user = json_extract_scalar(user, "$.string"),
     object = json_extract_scalar(object, "$.string"),
     client_type = to_integer(json_extract_scalar(client_type, "$.int")),
     auth_event_name = json_extract_scalar(auth_event_name, "$.enumeration.value.string");

[RULE:extract_filedata_only_fields]
alter threat_category = json_extract_scalar(threat_category, "$.enumeration.value.string"),
      threat_name_firewall = json_extract_scalar(threat_name_firewall, "$.string"),
      direction_of_attack = json_extract_scalar(direction_of_attack, "$.enumeration.value.string"),
      url_category = json_extract_scalar(url_category, "$.enumeration.value.string"),
      file_name = json_extract_scalar(file_name, "$.string"),
      file_type = json_extract_scalar(file_type, "$.string"),
      content_version = json_extract_scalar(content_version, "$.string"),
      cloud_hostname = json_extract_scalar(cloud_hostname, "$.string"),
      file_url = json_extract_scalar(file_url, "$.string"),
      sig_flags = to_integer(json_extract_scalar(sig_flags, "$.int")),
      pcap_id = to_integer(json_extract_scalar(pcap_id, "$.long")),
      file_id = to_integer(json_extract_scalar(file_id, "$.long")),
      flags = to_integer(json_extract_scalar(flags, "$.long")),
      report_id = to_integer(json_extract_scalar(report_id, "$.long")),
      vendor_severity = json_extract_scalar(vendor_severity, "$.value.string"),
      severity = coalesce(json_extract_scalar(severity, "$.severity"), json_extract_scalar(severity, "$['firewall.severity']")),
      file_sha_256 = json_extract_scalar(file_sha_256, "$.string");

[RULE:extract_globalprotect_only_fields]
alter connection_error = json_extract_scalar(connection_error, "$.enumeration.value.string"),
      event_id = json_extract_scalar(event_id, "$.enumeration.value.string"),
      status = json_extract_scalar(status, "$.enumeration.value.string"),
      endpoint_gp_version = to_integer(json_extract_scalar(endpoint_gp_version, "$.int")),
      ssl_response_time = to_integer(json_extract_scalar(ssl_response_time, "$.int")),
      login_duration = to_integer(json_extract_scalar(login_duration, "$.long")),
      endpoint_os_type = json_extract_scalar(endpoint_os_type, "$.string"),
      endpoint_os_version = json_extract_scalar(endpoint_os_version, "$.string"),
      endpoint_device_name = json_extract_scalar(endpoint_device_name, "$.string"),
      opaque = json_extract_scalar(opaque, "$.string"),
      portal = json_extract_scalar(portal, "$.string"),
      source_region = json_extract_scalar(source_region, "$.string"),
      stage = json_extract_scalar(stage, "$.string"),
      host_id = json_extract_scalar(host_id, "$.string"),
      auth_method = json_extract_scalar(auth_method, "$.string"),
      gateway = json_extract_scalar(gateway, "$.string"),
      connect_method = json_extract_scalar(connect_method, "$.string"),
      private_ip = if(json_extract_scalar(private_ip, "$.ip_address.value") != "",
                        json_extract_scalar(private_ip, "$.ip_address.value"),
                        json_extract_scalar(private_ip, "$.ip_address.hex")),
      public_ip = if(json_extract_scalar(public_ip, "$.ip_address.value") != "",
                        json_extract_scalar(public_ip, "$.ip_address.value"),
                        json_extract_scalar(public_ip, "$.ip_address.hex")),
      private_ipv6 = if(json_extract_scalar(private_ipv6, "$.ip_address.value") != "",
                        json_extract_scalar(private_ipv6, "$.ip_address.value"),
                        json_extract_scalar(private_ipv6, "$.ip_address.hex")),
      public_ipv6 = if(json_extract_scalar(public_ipv6, "$.ip_address.value") != "",
                        json_extract_scalar(public_ipv6, "$.ip_address.value"),
                        json_extract_scalar(public_ipv6, "$.ip_address.hex"));

[RULE:extract_tunnel_only_fields]
alter access_point_name = json_extract_scalar(access_point_name, "$.string"),
      mobile_ip = if(json_extract_scalar(mobile_ip, "$.ip_address.value") != "",
                        json_extract_scalar(mobile_ip, "$.ip_address.value"),
                        json_extract_scalar(mobile_ip, "$.ip_address.hex")),
      mobile_subscriber_isdn = json_extract_scalar(mobile_subscriber_isdn, "$.string"),
      mobile_country_code = to_integer(json_extract_scalar(mobile_country_code, "$.int")),
      mobile_network_code = to_integer(json_extract_scalar(mobile_network_code, "$.int")),
      mobile_base_station_code = to_integer(json_extract_scalar(mobile_base_station_code, "$.int")),
      mobile_area_code = to_integer(json_extract_scalar(mobile_area_code, "$.int")),
      tunnel_event_code = to_integer(json_extract_scalar(tunnel_event_code, "$.int")),
      tunnel_event_type = to_integer(json_extract_scalar(tunnel_event_type, "$.int")),
      tunnel_message_type = to_integer(json_extract_scalar(tunnel_message_type, "$.int")),
      tunnel_sessions_created = to_integer(json_extract_scalar(tunnel_sessions_created, "$.int")),
      tunnel_sessions_closed = to_integer(json_extract_scalar(tunnel_sessions_closed, "$.int")),
      tunnel_cause_code = to_integer(json_extract_scalar(tunnel_cause_code, "$.int")),
      tunnel_endpoint_id_1 = to_integer(json_extract_scalar(tunnel_endpoint_id_1, "$.int")),
      tunnel_endpoint_id_2 = to_integer(json_extract_scalar(tunnel_endpoint_id_2, "$.int")),
      packets_dropped_ukn_proto = to_integer(json_extract_scalar(packets_dropped_ukn_proto, "$.int")),
      packets_dropped_max_encap = to_integer(json_extract_scalar(packets_dropped_max_encap, "$.int")),
      packets_dropped_strict_check = to_integer(json_extract_scalar(packets_dropped_strict_check, "$.int")),
      packets_dropped_tunnel_frag = to_integer(json_extract_scalar(packets_dropped_tunnel_frag, "$.int")),
      radio_access_technology = to_integer(json_extract_scalar(radio_access_technology, "$.int")),
      tunnel_interface = to_integer(json_extract_scalar(tunnel_interface, "$.int")),
      tunnel_inspection_rule = json_extract_scalar(tunnel_inspection_rule, "$.string"),
      tunnel_remote_user_ip = if(json_extract_scalar(tunnel_remote_user_ip, "$.ip_address.value") != "",
                        json_extract_scalar(tunnel_remote_user_ip, "$.ip_address.value"),
                        json_extract_scalar(tunnel_remote_user_ip, "$.ip_address.hex")),
      tunnel_remote_imsi_id = to_integer(json_extract_scalar(tunnel_interface, "$.long")),
      standard_ports_of_app = json_extract_scalar(standard_ports_of_app, "$.string"),
      pdu_session_id = to_integer(json_extract_scalar(pdu_session_id, "$.int")); 

[RULE:extract_config_only_fields]
alter admin_user = admin_user -> string, 
      admin_user_info_domain = admin_user_info -> user_info.domain.string,
      admin_user_info_name = admin_user_info -> user_info.name.string,
      admin_user_info_uuid = to_integer(admin_user_info -> user_info.uuid.long),
      client = client -> enumeration.value.string,
      event_client_ip = if(event_client_ip -> ip_address.value != "", 
                  event_client_ip -> ip_address.value, 
                  event_client_ip -> ip_address.hex),
      event_detail = event_detail -> string, 
      event_path = event_path -> string, 
      event_result = event_result -> enumeration.value.string, 
      log_source_group_id = log_source_group_id -> string,
      platform_type = platform_type -> string;


/* -------------------------------
   ---------- INGESTS ------------
   ------------------------------- */

[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_hipmatch_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.hipmatch"
| alter _time = time_generated
| call extract_common_ngfw_fields
| call extract_hipmatch_only_fields
| call common_post_processing;

[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_threat_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.threat"
| alter _time = time_generated
| call extract_common_ngfw_fields
| call extract_common_threat_traffic_url_filedata_fields
| call extract_threat_url_common_fields
| call extract_threat_only_fields
| call common_post_processing
| call threat_traffic_url_common_post_processing;

[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_traffic_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.traffic"
| call extract_common_ngfw_fields
| call extract_common_threat_traffic_url_filedata_fields
| call extract_traffic_only_fields
| alter _time = time_generated
| call common_post_processing
| call threat_traffic_url_common_post_processing;

[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_url_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.url"
| alter _time = time_generated
| call extract_common_ngfw_fields
| call extract_common_threat_traffic_url_filedata_fields
| call extract_threat_url_common_fields
| call extract_url_only_fields
| call common_post_processing
| call threat_traffic_url_common_post_processing
| fields - threat_name_firewall, domain_edl, partial_hash;  // not shown by EXPLORE app

[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_filedata_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.file_data"
| alter _time = time_generated
| call extract_common_ngfw_fields
| call extract_filedata_only_fields
| call extract_common_threat_traffic_url_filedata_fields
| call threat_traffic_url_common_post_processing
| call common_post_processing;


[INGEST:vendor=panw, product=ngfw, target_dataset=panw_ngfw_globalprotect_raw, no_hit=drop, ingestnull=false]
filter __firewall_type = "firewall.globalprotect"
| alter _time = time_generated
| call extract_common_ngfw_fields
| call extract_globalprotect_only_fields
| call common_post_processing;


